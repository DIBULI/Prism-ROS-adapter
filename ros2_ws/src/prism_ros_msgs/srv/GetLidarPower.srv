# All capture streams must be stopped. Query never wakes the radar.
uint32 timeout_ms
---
bool success
string message
# Valid only if success=true. Failed writes may have reached the radar.
# Model: 1 MID360, 2 MID360S, 3 XT32; driver lidar_model selects the target.
uint8 model
uint8 UNKNOWN=0
uint8 RUNNING=1
uint8 STANDBY=2
uint8 TRANSITIONING=3
uint8 ERROR=4
uint8 state
uint32 vendor_state
